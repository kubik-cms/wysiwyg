<div class="input kubik-wysiwyg-links-repeater">
  <label class="label"><%= @field_label %></label>

  <% @rows.each_with_index do |row, row_index| %>
    <% row = row.to_h.with_indifferent_access %>
    <div class="kubik-wysiwyg-links-repeater__row">
      <div class="kubik-wysiwyg-link-metadata">
        <div class="input">
          <label class="label">Link text</label>
          <input type="text"
                 name="<%= row_field_name(row_index, 'text') %>"
                 value="<%= row[:text] %>"
                 class="input"
                 data-action="input->kubik-widget#updateField" />
        </div>

        <div class="input select">
          <label class="label">Target</label>
          <%= select_tag row_field_name(row_index, 'target'),
                         options_for_select(target_select_options, row[:target]),
                         class: 'input',
                         data: { action: 'change->kubik-widget#updateField' } %>
        </div>

        <div class="input select">
          <label class="label">Rel</label>
          <%= select_tag row_field_name(row_index, 'rel'),
                         options_for_select(rel_select_options, row[:rel]),
                         class: 'input',
                         data: { action: 'change->kubik-widget#updateField' } %>
        </div>
      </div>

      <% if @navigable_available %>
        <%= render Kubik::WysiwygEditor::Common::Field::NavigableLink.new(
              navigable_row_field(row_index),
              @data,
              @widget_id,
              @tab,
              @index,
            ) %>
      <% else %>
        <div class="input">
          <label class="label">URL</label>
          <input type="text"
                 name="<%= row_field_name(row_index, 'url') %>"
                 value="<%= row[:url] %>"
                 class="input"
                 data-action="input->kubik-widget#updateField" />
        </div>
      <% end %>

      <% if style_select? %>
        <div class="input select">
          <label class="label">Style</label>
          <select name="<%= row_field_name(row_index, 'style') %>"
                  class="input"
                  data-action="change->kubik-widget#updateField">
            <% style_options.each do |option| %>
              <option value="<%= option[:value] %>" <%= 'selected' if option[:value].to_s == row[:style].to_s %>>
                <%= option[:label] %>
              </option>
            <% end %>
          </select>
        </div>
      <% end %>

      <button type="button"
              class="kubik-wysiwyg-links-repeater__remove material-symbols-outlined"
              data-action="click->kubik-widget#removeLinksRow"
              data-kubik-widget-tab-param="<%= tab_name %>"
              data-kubik-widget-field-param="<%= @field[:name] %>"
              data-kubik-widget-index-param="<%= row_index %>">close</button>
    </div>
  <% end %>

  <div class="kubik-wysiwyg-repeated-item--add-new"
       data-action="click->kubik-widget#appendLinksRow"
       data-kubik-widget-tab-param="<%= tab_name %>"
       data-kubik-widget-field-param="<%= @field[:name] %>">
    <%= @rows.present? ? "Add another" : "Add" %>
  </div>

  <% if @field[:hint].present? %>
    <p class="inline-hints"><%= @field[:hint] %></p>
  <% end %>
</div>
