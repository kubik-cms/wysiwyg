<%# locals: items, repeated_items, title, content, link_text, link_url %>
<%# TODO: customise card layout for <%= @model_class %> (Card or site component). %>
<% items_list = local_assigns[:items].presence || local_assigns[:repeated_items] || [] %>

<% if items_list.present? %>
  <div class="<%= file_name %>-listing-wysiwyg-block">
    <%= render partial: 'layouts/partials/listing/articles_listing_header',
               locals: { title: local_assigns[:title], content: local_assigns[:content] } %>

    <section class="layout-item--to-left max-content-width <%= file_name %>-listing-wysiwyg <%= file_name %>-listing-wysiwyg--large">
      <div class="<%= file_name %>-listing-wysiwyg__items">
        <% items_list.each do |item| %>
          <% row = normalize_wysiwyg_<%= file_name %>_list_item(item) %>
          <% next if row.nil? %>
          <% next if row[:title].blank? && row[:path].blank? %>

          <%= render Card::CardComponent.new(
            title: row[:title],
            summary: row[:summary],
            path: row[:path],
            image: row[:image],
            breadcrumbs: Breadcrumb::BreadcrumbComponent.new(
              trail: ['<%= class_name %>', row[:date_published]].compact,
              color: :blue,
            ),
          ) %>
        <% end %>
      </div>

      <% if local_assigns[:link_url].present? && local_assigns[:link_text].present? %>
        <div class="<%= file_name %>-listing-wysiwyg__link">
          <%= render Button::ButtonComponent.new(
            text: local_assigns[:link_text],
            aria_label: local_assigns[:link_text],
            href: local_assigns[:link_url],
            arrow: true,
            small: true,
            color: :blue,
          ) %>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
