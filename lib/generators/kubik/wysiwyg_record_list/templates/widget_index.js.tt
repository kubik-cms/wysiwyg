import Wysiwyg from '@kubik-cms/wysiwyg';

const { defineRecordListBlock, presets } = Wysiwyg;

const Icon =
  '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm80-80h400L520-480 400-320l-80-107-40 53Zm-80 80v-560 560Z"/></svg>';

const ADMIN_SEARCH_PATH = '/<%= @admin_search_path %>';

export default defineRecordListBlock({
  toolbox: { title: '<%= @toolbox_title %>', icon: Icon },
  widget_name: '<%= @widget_name %>',
  model: '<%= @model_class %>',
  adminSearchPath: ADMIN_SEARCH_PATH,
  addLabel: 'Add another',
  queries: [
<% @queries.each do |query| -%>
    { value: '<%= query[:value] %>', label: '<%= query[:label] %>' },
<% end -%>
  ],
  layouts: [
<% @layouts.each do |layout| -%>
    { value: '<%= layout[:value] %>', label: '<%= layout[:label] %>' },
<% end -%>
  ],
  settingsExtras: [...presets.standardSettingsExtras().slice(1)],
  allowLiveQuery: true,
  allowSnapshot: false,
});
