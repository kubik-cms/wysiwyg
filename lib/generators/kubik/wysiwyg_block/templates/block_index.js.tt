import Wysiwyg from '@kubik-cms/wysiwyg';

const { defineBlock, presets } = Wysiwyg;
const Icon = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/></svg>';

export default defineBlock({
  toolbox: {
    title: '<%= class_name %>',
    icon: Icon,
  },
  sanitize: {
    intro: { br: true },
  },
  widgetConfig: {
    widget_name: '<%= @block_type %>',
    icon: Icon,
    tabs: [
      presets.contentTab([
        { name: 'body', label: 'Body', type: 'textarea' },
      ]),
      presets.settingsTab({ layouts: [] }),
    ],
  },
});
